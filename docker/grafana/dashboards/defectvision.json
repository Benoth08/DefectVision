{
  "uid": "defectvision",
  "title": "DefectVision — Inspection en production",
  "description": "Service d'inspection : trafic, latence, décisions des modèles, revues opérateur et dérive des images reçues.",
  "tags": ["defectvision", "mlops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Jeu de modèles en service",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max by (version) (defectvision_model_info)", "legendFormat": "{{version}}", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "name", "colorMode": "none", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []}
    },
    {
      "id": 2, "type": "stat", "title": "Pièces inspectées (période)",
      "gridPos": {"x": 6, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(defectvision_predictions_total[$__range]))", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "none", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []}
    },
    {
      "id": 3, "type": "stat", "title": "Taux de défauts — hybride (période)",
      "gridPos": {"x": 10, "y": 0, "w": 5, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(defectvision_predictions_total{model=\"hybrid\",label=\"DEFAUT\"}[$__range])) / clamp_min(sum(increase(defectvision_predictions_total{model=\"hybrid\"}[$__range])), 1e-9)", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "none", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1}, "overrides": []}
    },
    {
      "id": 4, "type": "stat", "title": "Revues opérateur — hybride (période)",
      "gridPos": {"x": 15, "y": 0, "w": 5, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(defectvision_review_required_total{model=\"hybrid\"}[$__range])) / clamp_min(sum(increase(defectvision_predictions_total{model=\"hybrid\"}[$__range])), 1e-9)", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "none", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1}, "overrides": []}
    },
    {
      "id": 5, "type": "stat", "title": "Latence p95 /predict",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(defectvision_http_request_duration_seconds_bucket{route=\"/predict\"}[5m])))", "instant": true}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "#0ca30c", "value": null}, {"color": "#fab219", "value": 0.5}, {"color": "#d03b3b", "value": 1}]}}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "Prédictions par seconde, par modèle",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (model) (rate(defectvision_predictions_total[1m]))", "legendFormat": "{{model}}"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": [
        {"matcher": {"id": "byName", "options": "supervised"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#2a78d6"}}]},
        {"matcher": {"id": "byName", "options": "autoencoder"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#eb6834"}}]},
        {"matcher": {"id": "byName", "options": "hybrid"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#1baf7a"}}]}
      ]}
    },
    {
      "id": 7, "type": "timeseries", "title": "Latence de /predict (p50, p95, p99)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(defectvision_http_request_duration_seconds_bucket{route=\"/predict\"}[1m])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(defectvision_http_request_duration_seconds_bucket{route=\"/predict\"}[1m])))", "legendFormat": "p95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(defectvision_http_request_duration_seconds_bucket{route=\"/predict\"}[1m])))", "legendFormat": "p99"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 0}}, "overrides": [
        {"matcher": {"id": "byName", "options": "p50"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#86b6ef"}}]},
        {"matcher": {"id": "byName", "options": "p95"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#2a78d6"}}]},
        {"matcher": {"id": "byName", "options": "p99"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#104281"}}]}
      ]}
    },
    {
      "id": 8, "type": "timeseries", "title": "Part des pièces déclarées en défaut, par modèle (fenêtre 5 min)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (model) (rate(defectvision_predictions_total{label=\"DEFAUT\"}[5m])) / clamp_min(sum by (model) (rate(defectvision_predictions_total[5m])), 1e-9)", "legendFormat": "{{model}}"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"lineWidth": 2, "fillOpacity": 0}}, "overrides": [
        {"matcher": {"id": "byName", "options": "supervised"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#2a78d6"}}]},
        {"matcher": {"id": "byName", "options": "autoencoder"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#eb6834"}}]},
        {"matcher": {"id": "byName", "options": "hybrid"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#1baf7a"}}]}
      ]}
    },
    {
      "id": 9, "type": "timeseries", "title": "Modèle hybride : branche qui déclenche l'alerte",
      "description": "supervise : défaut connu ; non_supervise : anomalie vue par le seul autoencodeur (défaut peut-être nouveau) ; les_deux ; aucun.",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (source) (rate(defectvision_hybrid_source_total[5m]))", "legendFormat": "{{source}}"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10, "stacking": {"mode": "normal"}}}, "overrides": [
        {"matcher": {"id": "byName", "options": "supervise"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#2a78d6"}}]},
        {"matcher": {"id": "byName", "options": "non_supervise"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#eb6834"}}]},
        {"matcher": {"id": "byName", "options": "les_deux"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#1baf7a"}}]},
        {"matcher": {"id": "byName", "options": "aucun"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#898781"}}]}
      ]}
    },
    {
      "id": 10, "type": "heatmap", "title": "Distribution du score hybride P(défaut)",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (le) (increase(defectvision_score_bucket{model=\"hybrid\"}[$__rate_interval]))", "legendFormat": "{{le}}", "format": "heatmap"}],
      "options": {"calculate": false, "yAxis": {"axisLabel": "P(défaut)"}, "color": {"mode": "scheme", "scheme": "Blues", "steps": 64}, "cellGap": 1, "tooltip": {"mode": "single", "yHistogram": false}, "legend": {"show": true}},
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "id": 11, "type": "timeseries", "title": "Score d'anomalie normalisé z (médiane et p95)",
      "description": "Une hausse durable signale des pièces qui s'écartent de l'aspect normal appris.",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(defectvision_anomaly_z_bucket[5m])))", "legendFormat": "médiane"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(defectvision_anomaly_z_bucket[5m])))", "legendFormat": "p95"}
      ],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 0}}, "overrides": [
        {"matcher": {"id": "byName", "options": "médiane"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#f3a27f"}}]},
        {"matcher": {"id": "byName", "options": "p95"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#eb6834"}}]}
      ]}
    },
    {
      "id": 12, "type": "timeseries", "title": "Dérive des entrées : luminosité moyenne des images",
      "gridPos": {"x": 0, "y": 28, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(defectvision_input_mean_intensity_sum[5m])) / clamp_min(sum(rate(defectvision_input_mean_intensity_count[5m])), 1e-9)", "legendFormat": "luminosité moyenne"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": false}, "tooltip": {"mode": "single"}},
      "fieldConfig": {"defaults": {"unit": "none", "min": 0, "max": 255, "color": {"mode": "fixed", "fixedColor": "#2a78d6"}, "custom": {"lineWidth": 2, "fillOpacity": 0}}, "overrides": []}
    },
    {
      "id": 13, "type": "timeseries", "title": "Dérive des entrées : contraste moyen",
      "gridPos": {"x": 8, "y": 28, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(defectvision_input_contrast_sum[5m])) / clamp_min(sum(rate(defectvision_input_contrast_count[5m])), 1e-9)", "legendFormat": "écart-type des niveaux de gris"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": false}, "tooltip": {"mode": "single"}},
      "fieldConfig": {"defaults": {"unit": "none", "min": 0, "color": {"mode": "fixed", "fixedColor": "#2a78d6"}, "custom": {"lineWidth": 2, "fillOpacity": 0}}, "overrides": []}
    },
    {
      "id": 14, "type": "timeseries", "title": "Requêtes refusées, par motif",
      "gridPos": {"x": 16, "y": 28, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (reason) (rate(defectvision_prediction_errors_total[5m]))", "legendFormat": "{{reason}}"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 0}}, "overrides": []}
    },
    {
      "id": 15, "type": "timeseries", "title": "Codes de réponse HTTP de l'API",
      "gridPos": {"x": 0, "y": 36, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(defectvision_http_requests_total[1m]))", "legendFormat": "{{status}}"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 0}}, "overrides": []}
    },
    {
      "id": 16, "type": "timeseries", "title": "Passerelle nginx : requêtes par seconde",
      "gridPos": {"x": 12, "y": 36, "w": 6, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "rate(nginx_http_requests_total[1m])", "legendFormat": "requêtes / s"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": false}, "tooltip": {"mode": "single"}},
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "fixed", "fixedColor": "#2a78d6"}, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 17, "type": "timeseries", "title": "Passerelle nginx : connexions actives",
      "gridPos": {"x": 18, "y": 36, "w": 6, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "nginx_connections_active", "legendFormat": "connexions"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": false}, "tooltip": {"mode": "single"}},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "fixed", "fixedColor": "#2a78d6"}, "custom": {"lineWidth": 2, "fillOpacity": 0}}, "overrides": []}
    }
  ]
}
